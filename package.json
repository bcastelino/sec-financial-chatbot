{
  "name": "filing-room",
  "version": "3.0.0",
  "private": true,
  "description": "SEC-grounded research workspace for public company filings.",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @filing-room/web dev",
    "dev:gateway": "pnpm --filter @filing-room/gateway dev",
    "build": "pnpm --filter @filing-room/contracts build && pnpm --filter @filing-room/web build && pnpm --filter @filing-room/gateway build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm check:punctuation && pnpm -r lint",
    "check:punctuation": "node scripts/check-no-em-dash.mjs",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "typescript": "5.8.3"
  }
}
